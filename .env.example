# PostgreSQL
DATABASE_URL="postgresql://mpu:change-me@localhost:5432/mpu?schema=public"

# Auth.js / NextAuth. Generate with: openssl rand -base64 48
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"

# Hashing key for rate-limit identifiers. Use a different random secret.
RATE_LIMIT_SECRET="replace-with-another-random-secret"

# Object storage (S3-compatible: Neon production / MinIO local)
# Neon can use either these S3_* names or its generated AWS_* equivalents:
# AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="change-me"
S3_BUCKET_PUBLIC="mpu-public"
S3_BUCKET_PRIVATE="mpu-private"
S3_PUBLIC_BASE_URL="http://localhost:9000/mpu-public"
S3_FORCE_PATH_STYLE="true"

# Configurable upload limits (bytes)
MAX_IMAGE_UPLOAD_BYTES="10485760"
MAX_PDF_UPLOAD_BYTES="20971520"
MAX_VIDEO_UPLOAD_BYTES="157286400"
MAX_UPLOAD_BATCH="10"

# Public canonical URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# One-time bootstrap. Prefer interactive input; never commit real values.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
